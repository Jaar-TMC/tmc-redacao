# ============================================
# TMC RSS Collector - Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# Required - Azure SQL Database
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your-database
SQL_USERNAME=your-username
SQL_PASSWORD=your-password

# Required - LLM API (at least one must be set)
# Option A: Direct Anthropic API
ANTHROPIC_API_KEY=your-anthropic-key
# Option B: Azure AI (Claude via Azure)
AZURE_AI_API_KEY=your-azure-ai-key
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com/anthropic/v1/messages

# Required - Exa Search API (for article enrichment / anti-hallucination)
EXA_API_KEY=your-exa-key

# Required in Production - JWT Authentication
JWT_SECRET_KEY=your-secret-key-at-least-32-characters-long

# Required in Production - Safety mode (blocks unapproved articles)
PRODUCTION_SAFETY_MODE=true

# Required in Production - CORS (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ============================================
# Optional - Database
# ============================================
SQL_QUERY_TIMEOUT=30

# ============================================
# Optional - JWT Token Lifetimes
# ============================================
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ============================================
# Optional - Model Routing (override defaults)
# ============================================
# CLASSIFICATION_MODEL=claude-haiku-4-5
# SCORING_MODEL=claude-haiku-4-5
# THEME_NAMING_MODEL=claude-haiku-4-5
# EVENT_VERIFICATION_MODEL=claude-sonnet-4-5
# EVENT_EXTRACTION_MODEL=claude-sonnet-4-5
# ENRICHMENT_EXTRACTION_MODEL=claude-sonnet-4-5
# GENERATION_MODEL=claude-sonnet-4-5
# FACT_CHECK_MODEL=claude-sonnet-4-5
# EDIT_MODEL=claude-sonnet-4-5
# MERGE_MODEL=claude-sonnet-4-5

# ============================================
# Optional - Exa Search Tuning
# ============================================
# EXA_MAX_RESULTS=5
# EXA_SEARCH_DAYS=7

# ============================================
# Optional - Feature Flags (all default to true)
# ============================================
# FACT_CHECK_ENABLED=true
# FACT_CHECK_ENRICHMENT_ENABLED=true
# FACT_CHECK_VERIFICATION_ENABLED=true
# EVENT_EXTRACTION_ENABLED=true
# EVENT_MATCHING_ENABLED=true
# COVE_ENABLED=true
# DECONTAMINATION_ENABLED=true

# ============================================
# Optional - Safety Thresholds (defaults shown)
# ============================================
# MIN_SOURCE_CHARS=300
# NOTA_ONLY_THRESHOLD=500
# SHORT_SOURCE_THRESHOLD=800
# PUBLISH_CONFIDENCE_FLOOR=0.65
# PUBLISH_GROUNDED_FLOOR=0.70
# PUBLISH_MAX_EXPANSION=8.0

# ============================================
# Optional - Rate Limiting
# ============================================
# RATE_LIMIT_GENERATE=0.5
# RATE_LIMIT_BURST_GENERATE=3

# ============================================
# Optional - Monitoring
# ============================================
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string
