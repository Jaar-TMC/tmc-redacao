# TMC RSS Collector - Environment Variables
# Copy this file to .env and fill in your values

# ======================
# Database Configuration
# ======================
SQL_SERVER=bi4ia-tmc.database.windows.net
SQL_DATABASE=tmc
SQL_USERNAME=tmc_collector
SQL_PASSWORD=your_password_here

# ======================
# AI Services
# ======================

# Azure AI Services (Anthropic endpoint) - Preferred
AZURE_AI_API_KEY=your_azure_ai_key
AZURE_AI_ENDPOINT=https://modelos-chave-jaar-resource.services.ai.azure.com/anthropic/v1/messages

# OR Direct Anthropic API (fallback)
# ANTHROPIC_API_KEY=your_anthropic_key

# OpenAI for Embeddings
OPENAI_API_KEY=your_openai_key

# ======================
# Event-Based Clustering
# ======================
EVENT_EXTRACTION_ENABLED=true
EVENT_MATCHING_ENABLED=true
EVENT_VERIFICATION_ENABLED=true

# ======================
# Clustering Configuration
# ======================
CLUSTERING_ENABLED=true
CLUSTERING_SIMILARITY_THRESHOLD=0.50
CLUSTERING_EMA_ALPHA=0.15
CLUSTERING_MERGE_THRESHOLD=0.90
